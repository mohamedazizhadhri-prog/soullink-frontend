generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String?             @unique
  phone               String?             @unique
  passwordHash        String
  displayName         String
  handle              String              @unique
  bio                 String?
  avatarUrl           String?
  role                Role                @default(USER)
  status              AccountStatus       @default(PENDING_VERIFICATION)
  onlineStatus        OnlineStatus        @default(OFFLINE)
  dateOfBirth         DateTime
  emailVerified       Boolean             @default(false)
  phoneVerified       Boolean             @default(false)
  faceVerified        Boolean             @default(false)
  lastFaceVerify      DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  privacyProfile      PrivacyLevel        @default(PUBLIC)
  notificationsOn     Boolean             @default(true)
  faceDescriptor      Json?
  city                String?
  country             String?
  timezone            String?
  bannerUrl           String?
  aiConversations          AIConversation[]
  appeals                  Appeal[]
  auditLogs                AuditLog[]          @relation("UserAuditLogs")
  receivedDMs              DirectMessage[]     @relation("ReceivedDMs")
  sentDMs                  DirectMessage[]     @relation("SentDMs")
  receivedFriendships      Friendship[]        @relation("ReceivedFriendships")
  sentFriendships          Friendship[]        @relation("SentFriendships")
  gameResponses            GameResponse[]
  groupMatchMembers        GroupMatchMember[]
  loginHistory             LoginHistory[]
  receivedMatches          Match[]             @relation("ReceivedMatches")
  sentMatches              Match[]             @relation("SentMatches")
  messages                 Message[]
  modActionsBy             ModAction[]         @relation("ModActionBy")
  modActions               ModAction[]         @relation("ModActionTarget")
  notifications            Notification[]
  novaMemory               NovaUserMemory?
  personalityProfile       PersonalityProfile?
  receivedReports          Report[]            @relation("Reported")
  sentReports              Report[]            @relation("Reporter")
  serverBansIssued         ServerBan[]         @relation("BannedBy")
  serverBans               ServerBan[]         @relation("BannedUser")
  serverMembers            ServerMember[]
  serverMutesIssued        ServerMute[]        @relation("MutedBy")
  serverMutes              ServerMute[]        @relation("MutedUser")
  gameProgress             SoulGameProgress[]
  verifications            Verification[]
  matchPreference          MatchPreference?
  ownedMatchSuggestions    MatchSuggestion[]   @relation("SuggestionOwner")
  candidateSuggestions     MatchSuggestion[]   @relation("SuggestionCandidate")
  matchRequests            MatchRequest[]


  @@index([email])
  @@index([handle])
  @@index([status])
}

model Verification {
  id        String           @id @default(uuid())
  userId    String
  type      VerificationType
  code      String?
  token     String?
  verified  Boolean          @default(false)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SoulGame {
  id          String             @id @default(uuid())
  slug        String             @unique
  title       String
  description String
  color       String
  icon        String
  mandatory   Boolean            @default(false)
  episode     Int
  orderIndex  Int
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  theme       String             @default("personality")
  responses   GameResponse[]
  scenes      GameScene[]
  progress    SoulGameProgress[]

  @@index([slug])
}

model GameScene {
  id              String             @id @default(uuid())
  gameId          String
  sceneOrder      Int
  text            String
  bgImageUrl      String?
  createdAt       DateTime           @default(now())
  novaComment     String?
  novaMood        String?
  choices         GameChoice[]
  responses       GameResponse[]
  game            SoulGame           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  currentProgress SoulGameProgress[]

  @@index([gameId])
}

model GameChoice {
  id                String         @id @default(uuid())
  sceneId           String
  text              String
  themeColor        String
  icon              String?
  orderIndex        Int
  openness          Float          @default(0)
  conscientiousness Float          @default(0)
  extraversion      Float          @default(0)
  agreeableness     Float          @default(0)
  neuroticism       Float          @default(0)
  valueCategory     String?
  valueWeight       Float          @default(0)
  reflectionPrompt  String?
  scene             GameScene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  responses         GameResponse[]

  @@index([sceneId])
}

model GameResponse {
  id             String     @id @default(uuid())
  userId         String
  gameId         String
  sceneId        String
  choiceId       String
  responseTimeMs Int        @default(0)
  emotionalNote  String?
  createdAt      DateTime   @default(now())
  choice         GameChoice @relation(fields: [choiceId], references: [id])
  game           SoulGame   @relation(fields: [gameId], references: [id])
  scene          GameScene  @relation(fields: [sceneId], references: [id])
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

model PersonalityProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  openness          Float    @default(0.5)
  conscientiousness Float    @default(0.5)
  extraversion      Float    @default(0.5)
  agreeableness     Float    @default(0.5)
  neuroticism       Float    @default(0.5)
  interests         Json     @default("[]")
  insights          Json     @default("[]")
  lastCalculatedAt  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SoulGameProgress {
  id             String     @id @default(uuid())
  userId         String
  gameId         String
  currentSceneId String?
  isCompleted    Boolean    @default(false)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  currentScene   GameScene? @relation(fields: [currentSceneId], references: [id])
  game           SoulGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  summary     String?
  lastCheckIn DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
}

model AIMessage {
  id              String         @id @default(uuid())
  conversationId  String
  role            String
  content         String
  emotionDetected String?
  isProactive     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model MatchPreference {
  id                String      @id @default(uuid())
  userId            String      @unique
  intent            MatchIntent @default(FRIEND)
  selectedInterests String[]
  ageRangeMin       Int?
  ageRangeMax       Int?
  preferOnline      Boolean     @default(false)
  lastUpdatedAt     DateTime    @default(now())
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MatchRequest {
  id                String      @id @default(uuid())
  userId            String      @unique
  intent            MatchIntent @default(FRIEND)
  selectedInterests String[]
  isQuickMatch      Boolean     @default(false)
  createdAt         DateTime    @default(now())
  expiresAt         DateTime
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([intent])
  @@index([isQuickMatch])
}

model MatchSuggestion {
  id            String           @id @default(uuid())
  userId        String
  candidateId   String
  score         Float
  justification Json
  status        SuggestionStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  user          User             @relation("SuggestionOwner", fields: [userId], references: [id], onDelete: Cascade)
  candidate     User             @relation("SuggestionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateId])
  @@index([userId, status])
  @@index([candidateId])
}

model Match {
  id                 String             @id @default(uuid())
  senderId           String
  receiverId         String
  type               MatchType          @default(ONE_TO_ONE)
  status             MatchStatus        @default(PENDING)
  compatibilityScore Float
  justification      Json
  isAnonymous        Boolean            @default(true)
  identityRevealed   Boolean            @default(false)
  anonymousName      String?
  isQuickMatch       Boolean             @default(false)
  leftById           String?
  revealRequestedBy  String[]            @default([])
  expiresAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  receiver           User               @relation("ReceivedMatches", fields: [receiverId], references: [id])
  sender             User               @relation("SentMatches", fields: [senderId], references: [id])
  conversation       MatchConversation?

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
}

model GroupMatch {
  id        String             @id @default(uuid())
  name      String?
  maxSize   Int                @default(8)
  expiresAt DateTime
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  members   GroupMatchMember[]
}

model GroupMatchMember {
  id           String     @id @default(uuid())
  groupMatchId String
  userId       String
  joinedAt     DateTime   @default(now())
  groupMatch   GroupMatch @relation(fields: [groupMatchId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([groupMatchId, userId])
}

model MatchConversation {
  id        String         @id @default(uuid())
  matchId   String         @unique
  createdAt DateTime       @default(now())
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages  MatchMessage[]
}

model MatchMessage {
  id             String            @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType       @default(TEXT)
  content        String
  fileUrl        String?
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  conversation   MatchConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("ReceivedFriendships", fields: [receiverId], references: [id])
  sender     User             @relation("SentFriendships", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
}

model DirectMessage {
  id         String          @id @default(uuid())
  senderId   String
  receiverId String
  type       MessageType     @default(TEXT)
  content    String
  fileUrl    String?
  read       Boolean         @default(false)
  createdAt  DateTime        @default(now())
  editedAt   DateTime?
  isPinned   Boolean         @default(false)
  replyToId  String?
  receiver   User            @relation("ReceivedDMs", fields: [receiverId], references: [id])
  replyTo    DirectMessage?  @relation("DMReplies", fields: [replyToId], references: [id])
  replies    DirectMessage[] @relation("DMReplies")
  sender     User            @relation("SentDMs", fields: [senderId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model CallLog {
  id         String    @id @default(uuid())
  callerId   String
  receiverId String
  type       String
  duration   Int?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([callerId])
  @@index([receiverId])
}

model ActivityRoom {
  id        String   @id @default(uuid())
  name      String
  type      String
  hostId    String
  isActive  Boolean  @default(true)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
}

model Server {
  id          String         @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  isPublic    Boolean        @default(true)
  ownerId     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bannerUrl   String?
  inviteCode  String         @unique
  maxMembers  Int            @default(100)
  auditLogs   AuditLog[]     @relation("ServerAuditLogs")
  channels    Channel[]
  bans        ServerBan[]
  members     ServerMember[]
  mutes       ServerMute[]

  @@index([isPublic])
  @@index([inviteCode])
}

model Channel {
  id             String      @id @default(uuid())
  serverId       String
  name           String
  type           ChannelType @default(TEXT)
  groupName      String
  orderIndex     Int         @default(0)
  createdAt      DateTime    @default(now())
  isAnnouncement Boolean     @default(false)
  minPostRole    ServerRole  @default(MEMBER)
  server         Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([serverId])
}

model ServerMember {
  id       String     @id @default(uuid())
  serverId String
  userId   String
  role     ServerRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  nickname String?
  server   Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id])

  @@unique([serverId, userId])
}

model ServerBan {
  id         String    @id @default(uuid())
  serverId   String
  userId     String
  reason     String
  bannedById String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  bannedBy   User      @relation("BannedBy", fields: [bannedById], references: [id])
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User      @relation("BannedUser", fields: [userId], references: [id])

  @@unique([serverId, userId])
  @@index([serverId])
}

model ServerMute {
  id        String   @id @default(uuid())
  serverId  String
  userId    String
  reason    String
  mutedById String
  expiresAt DateTime
  createdAt DateTime @default(now())
  mutedBy   User     @relation("MutedBy", fields: [mutedById], references: [id])
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation("MutedUser", fields: [userId], references: [id])

  @@unique([serverId, userId])
  @@index([serverId])
}

model Message {
  id        String      @id @default(uuid())
  channelId String
  authorId  String
  type      MessageType @default(TEXT)
  content   String
  fileUrl   String?
  createdAt DateTime    @default(now())
  editedAt  DateTime?
  isPinned  Boolean     @default(false)
  replyToId String?
  author    User        @relation(fields: [authorId], references: [id])
  channel   Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo   Message?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[]   @relation("MessageReplies")

  @@index([channelId])
}

model Report {
  id            String         @id @default(uuid())
  reporterId    String
  reportedId    String
  category      ReportCategory
  description   String
  evidence      Json           @default("[]")
  status        ReportStatus   @default(PENDING)
  assignedModId String?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appeal        Appeal?
  modActions    ModAction[]
  reported      User           @relation("Reported", fields: [reportedId], references: [id])
  reporter      User           @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status])
  @@index([reportedId])
}

model ModAction {
  id        String        @id @default(uuid())
  reportId  String?
  targetId  String
  modId     String
  action    ModActionType
  reason    String
  duration  Int?
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  moderator User          @relation("ModActionBy", fields: [modId], references: [id])
  report    Report?       @relation(fields: [reportId], references: [id])
  target    User          @relation("ModActionTarget", fields: [targetId], references: [id])

  @@index([targetId])
}

model Appeal {
  id         String       @id @default(uuid())
  reportId   String       @unique
  userId     String
  reason     String
  status     AppealStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  report     Report       @relation(fields: [reportId], references: [id])
  user       User         @relation(fields: [userId], references: [id])

  @@index([status])
}

model ShameWall {
  id        String    @id @default(uuid())
  userId    String
  reason    String
  addedAt   DateTime  @default(now())
  expiresAt DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  createdAt DateTime @default(now())
  actorId   String
  details   Json?    @default("{}")
  serverId  String
  targetId  String?
  actor     User     @relation("UserAuditLogs", fields: [actorId], references: [id])
  server    Server   @relation("ServerAuditLogs", fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([actorId])
  @@index([createdAt])
}

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  date               DateTime @unique
  totalUsers         Int      @default(0)
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  totalMatches       Int      @default(0)
  successfulMatches  Int      @default(0)
  totalMessages      Int      @default(0)
  totalReports       Int      @default(0)
  resolvedReports    Int      @default(0)
  avgResponseTimeMs  Float    @default(0)
  avgMatchScore      Float    @default(0)
  retentionRate      Float    @default(0)
  premiumConversions Int      @default(0)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())

  @@index([date])
}

model AIModelVersion {
  id         String    @id @default(uuid())
  name       String
  version    String
  type       String
  config     Json      @default("{}")
  isActive   Boolean   @default(false)
  deployedAt DateTime?
  createdAt  DateTime  @default(now())
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model NovaUserMemory {
  id                 String   @id @default(uuid())
  userId             String   @unique
  nickname           String?
  occupation         String?
  currentMood        String?
  emotionalTrend     String?
  topInterests       String[]
  lifeGoals          String[]
  currentStruggles   String[]
  importantPeople    String[]
  lastTopicDiscussed String?
  insideJokes        String[]
  preferredTone      String?
  trustLevel         Int      @default(0)
  friendshipStage    String   @default("NEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  city               String?
  country            String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  PENDING_FACE_VERIFY
  PENDING_SOUL_GAME
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum PrivacyLevel {
  PUBLIC
  MATCHES_ONLY
  FRIENDS_ONLY
  PRIVATE
}

enum OnlineStatus {
  ONLINE
  AWAY
  DO_NOT_DISTURB
  OFFLINE
}

enum VerificationType {
  EMAIL
  PHONE
  FACE_INITIAL
  FACE_PERIODIC
  PASSWORD_RESET
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum MatchType {
  ONE_TO_ONE
  GROUP
}

enum MatchIntent {
  FRIEND
  DEEP_BOND
  GAMING
  STUDY_BUDDY
  ROMANCE
}

enum SuggestionStatus {
  PENDING
  LIKED
  PASSED
  MATCHED
  EXPIRED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  GIF
  SYSTEM
  VIDEO
}

enum ChannelType {
  TEXT
  VOICE
}

enum ServerRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_WARNING
  RESOLVED_SUSPENSION
  RESOLVED_BAN
  DISMISSED
  APPEALED
}

enum ReportCategory {
  HARASSMENT
  SPAM
  FAKE_IDENTITY
  INAPPROPRIATE_CONTENT
  HATE_SPEECH
  UNDERAGE
  OTHER
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ModActionType {
  WARNING
  MUTE
  SUSPENSION
  BAN
  UNBAN
  CONTENT_REMOVAL
}
